##############################################################################
# Money Compass - single configuration surface
#
# Copy this file to infra/.env and fill in the blanks. Nothing else in the
# repository needs editing to change a database, a model, or a provider.
#
#   cp infra/.env.example infra/.env
#
# Two consumers read this exact file:
#   1. docker compose      -> via `env_file: ../infra/.env` in docker-compose.yml
#   2. the Spring app      -> via `spring.config.import` in application.yml,
#                             so `./mvnw spring-boot:run` picks it up too
#
# Values are read literally. Do not wrap them in quotes and do not put a
# trailing comment on the same line as a value - both end up inside the value.
##############################################################################


# =============================================================================
# 1. RUNTIME PROFILE
# =============================================================================
# local -> primary is Ollama, fallback is Ollama. No cloud keys needed.
# prod  -> primary is OpenAI, fallback is AWS Bedrock. Cloud keys required.
SPRING_PROFILES_ACTIVE=local

# Port the backend binds to. Change only if 8080 is taken.
SERVER_PORT=8080


# =============================================================================
# 2. DATABASE  (PostgreSQL 16)
# =============================================================================
# ---- Option A: the bundled container (default, nothing to sign up for) ------
# `docker compose up postgres` creates this database with these credentials.
# Leave as-is unless you want different credentials.
#
# ---- Option B: a hosted Postgres -------------------------------------------
# Paste your provider's connection details below. Where to find them:
#   Neon .............. console.neon.tech -> your project -> Connection Details
#   Supabase .......... supabase.com/dashboard -> Project Settings -> Database
#   Render ............ dashboard.render.com -> your Postgres -> Connections
#   AWS RDS ........... console.aws.amazon.com/rds -> your instance -> Endpoint
#
# Providers usually hand you a URI like:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Split it into the three variables below. Note the `jdbc:` prefix on DB_URL
# and that the username and password are NOT part of DB_URL.
#
#   postgresql://mc:secret@ep-x.aws.neon.tech/moneycompass?sslmode=require
#   becomes
#   DB_URL=jdbc:postgresql://ep-x.aws.neon.tech:5432/moneycompass?sslmode=require
#   DB_USER=mc
#   DB_PASSWORD=secret
#
# If you switch to a hosted database, also set DB_HOST_FOR_COMPOSE below or
# start the stack without the postgres service.

DB_URL=jdbc:postgresql://localhost:5432/moneycompass
DB_USER=mc
DB_PASSWORD=mc

# Only used by the postgres container in docker-compose.yml. These must match
# the database name and credentials embedded in DB_URL/DB_USER/DB_PASSWORD
# above when you are using the bundled container.
POSTGRES_DB=moneycompass
POSTGRES_USER=mc
POSTGRES_PASSWORD=mc

# Hostname the backend container uses to reach Postgres. Inside the compose
# network the service is called `postgres`; from your host it is `localhost`.
# The backend container overrides DB_URL with this value automatically.
DB_HOST_FOR_COMPOSE=postgres


# =============================================================================
# 3. SECURITY
# =============================================================================
# HMAC-SHA256 signing key for JWTs. MUST be at least 32 bytes or the app
# refuses to start. Generate one:
#
#   openssl rand -base64 48
#
# Never commit the filled-in value. infra/.env is gitignored.
JWT_SECRET=

# Access token lifetime. The spec calls for 24h.
JWT_TTL_HOURS=24


# =============================================================================
# 4. AI PROVIDER ROUTING  (application logic, not a Spring AI feature)
# =============================================================================
# Which model answers first, and what catches it when that fails.
# AI_PRIMARY  : ollama | openai
# AI_FALLBACK : bedrock | ollama | none
#
# The `local` profile defaults to ollama/ollama so the fallback path is
# exercisable without spending money. The `prod` profile defaults to
# openai/bedrock.
AI_PRIMARY=ollama
AI_FALLBACK=ollama


# =============================================================================
# 5. OLLAMA  (local model, free)
# =============================================================================
# From your host machine .......... http://localhost:11434
# From inside the backend container http://ollama:11434
# The compose file sets the container value; this one is for `mvnw spring-boot:run`.
OLLAMA_BASE_URL=http://localhost:11434

# llama3.1:8b needs roughly 6 GB of RAM at 4-bit quantisation.
# On a machine with less, switch to llama3.2:3b here AND in infra/ollama-pull.sh.
OLLAMA_MODEL=llama3.1:8b

# Set to true for a "thinking" model (qwen3, deepseek-r1). Their hidden
# reasoning pass can make every explanation take minutes on a laptop. Leave
# false for models without a thinking mode.
OLLAMA_DISABLE_THINKING=false


# =============================================================================
# 6. OPENAI  (primary in prod)
# =============================================================================
# Create a key: https://platform.openai.com/api-keys
# Add credit first, or every call returns 429: https://platform.openai.com/settings/organization/billing
# Keys start with `sk-`. Paste the whole thing, no quotes.
OPENAI_API_KEY=

# Model list and pricing: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini


# =============================================================================
# 7. AWS BEDROCK  (fallback in prod)
# =============================================================================
# Three things must be true before the first call succeeds:
#
#   1. Model access is granted, per region. This is a manual approval step and
#      it is the single most common reason Bedrock returns AccessDeniedException:
#      https://console.aws.amazon.com/bedrock/home#/modelaccess
#      Request access to the Meta Llama family, then wait for status "Access granted".
#
#   2. The model ID exists in AWS_REGION. Availability differs by region;
#      us-east-1 has the broadest Llama coverage. Check the current list at:
#      https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
#
#   3. The IAM user or role below can call it. Minimum policy - see
#      docs/configuration.md section 7 for the full JSON.
#
# Credentials: https://console.aws.amazon.com/iam/home#/users -> Security credentials
# On EC2 or ECS, leave both blank and attach an instance role instead; the SDK
# picks it up from the default credential chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. Only for temporary STS credentials.
AWS_SESSION_TOKEN=

BEDROCK_MODEL=meta.llama3-1-8b-instruct-v1:0


# =============================================================================
# 8. APPLICATION TUNING
# =============================================================================
# Hard ceiling on questions served per session.
QUESTIONNAIRE_MAX_QUESTIONS=30

# Applied to both providers on every call. Low temperature keeps the narrative
# stable; the numeric score is computed in Java and never comes from the model.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800


# =============================================================================
# 9. FRONTEND
# =============================================================================
# Base URL the Angular app calls. Written into the environment files at build
# time. Needs the scheme and no trailing slash.
API_BASE_URL=http://localhost:8080

# Comma separated origins allowed to call the API. Add your deployed frontend
# origin here before you deploy, or the browser blocks every request.
CORS_ALLOWED_ORIGINS=http://localhost:4200
